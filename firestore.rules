rules_version = '2';

// Quién puede leer y escribir la agenda.
// ✏️ FAMILY_EMAIL debe ser el mismo que pusiste en public/js/firebase-config.js
//    (la cuenta familiar compartida, con contraseña).
// ✏️ Opcional: añade en la lista las cuentas de Google de quien quiera entrar con su propio Gmail.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null && (
        request.auth.token.email == 'familia@guachis-home.app'
        || (request.auth.token.email_verified == true
            && request.auth.token.email in [
              // 'carles@gmail.com',
            ])
      );
    }

    match /activities/{id} {
      allow read: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.person in ['carles', 'adriana', 'gabri', 'franci']
        && request.resource.data.startDate is string
        && request.resource.data.lastDate is string;
      allow delete: if isFamily();
    }

    // Tokens de dispositivos para los avisos push
    match /devices/{token} {
      allow read, write: if isFamily();
    }

    // Registro interno de avisos enviados (solo lo usa la Cloud Function)
    match /sentAlerts/{id} {
      allow read, write: if false;
    }
  }
}
